{
  "functions": {
    "api/cron/keep-alive.js": {
      "maxDuration": 10
    }
  },
  "crons": [
    {
      "path": "/api/cron/keep-alive",
      "schedule": "0 6 * * *"
    }
  ],
  "buildCommand": "CI=false npm install --legacy-peer-deps && npm run build",
  "installCommand": "npm install --legacy-peer-deps",
  "rewrites": [
    { "source": "/(.*)", "destination": "/" }
  ]
}